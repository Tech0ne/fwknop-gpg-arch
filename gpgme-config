#!/bin/sh
# Minimal gpgme-config replacement backed by pkg-config (gpgme >= 2.0 no longer ships it)
for arg in "$@"; do
  case "$arg" in
    --version)     pkg-config --modversion gpgme ;;
    --api-version) echo 1 ;;
    --cflags)      pkg-config --cflags gpgme ;;
    --libs)        pkg-config --libs gpgme ;;
    --prefix)      pkg-config --variable=prefix gpgme ;;
    --exec-prefix) pkg-config --variable=exec_prefix gpgme ;;
    --host)        ${CC:-cc} -dumpmachine ;;
    --thread=*)    ;;
    *)             ;;
  esac
done
